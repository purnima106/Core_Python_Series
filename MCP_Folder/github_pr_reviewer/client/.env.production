# Production / Docker environment
# Used automatically by Vite when running: npm run build
#
# VITE_API_URL is intentionally EMPTY so that all fetch() calls use
# relative paths like /api/review. Nginx then proxies /api/* to the
# backend container via its internal Docker DNS name (http://backend:8000).
# The browser NEVER resolves "backend" — only Nginx does, inside Docker.
#
# DO NOT set this to http://backend:8000  (only resolvable inside Docker network, not in browser)
# DO NOT set this to http://localhost:8000 (bypasses Nginx, only works on host)
VITE_API_URL=
